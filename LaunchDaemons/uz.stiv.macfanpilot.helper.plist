<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>uz.stiv.macfanpilot.helper</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/MacFanPilotHelper</string>
    <key>MachServices</key>
    <dict>
        <key>uz.stiv.macfanpilot.helper</key>
        <true/>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>uz.stiv.macfanpilot</string>
    </array>
    <!-- Relaunch after a crash so the helper can hand the fans back to macOS.
         A clean exit (idle, SIGTERM) is left alone. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
